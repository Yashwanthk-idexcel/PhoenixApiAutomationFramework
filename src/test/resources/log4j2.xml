<Configuration>
	<appenders>
		<Console name="CONSOLE" target="SYSTEM_OUT">
			<Patternlayout pattern="%d [%t] %highlight{%5p} %c:%l - %m%n"></Patternlayout>
		</Console>
	</appenders>

	<loggers>
		<root level="info">
			<AppenderRef ref="CONSOLE"></AppenderRef>
		</root>
	</loggers>
</Configuration>